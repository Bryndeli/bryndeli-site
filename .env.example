# Copy to .env (gitignored) for local dev, or set in Vercel project settings.
# Names only — never commit real values.

# Airtable — waiting list storage
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# Airtable — contact form storage (same base, separate table)
AIRTABLE_CONTACT_TABLE_NAME=

# Brevo — waiting list / contact form auto-reply email
BREVO_API_KEY=
MAIL_FROM_ADDRESS=

# Bryndeli for Families waitlist (api/families-waitlist.js) — see AIRTABLE.md
AIRTABLE_TOKEN=
AIRTABLE_WAITLIST_TABLE=
# Optional: survey link shown after signup (uses AIRTABLE_BASE_ID above)
FAMILIES_SURVEY_URL=
